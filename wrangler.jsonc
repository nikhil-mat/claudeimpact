{
  // Static site on Cloudflare Workers (Workers Static Assets). Build with `npm run build` first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudeimpact",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // the app uses hash routes (#/corporator), so every path falls back to index.html
    "not_found_handling": "single-page-application"
  }
}
